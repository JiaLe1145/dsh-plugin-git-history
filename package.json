{
  "name": "dsh-plugin-git-history",
  "version": "1.0.0",
  "type": "module",
  "description": "Git commit history panel for the DeepSeek Harness right sidebar: graph lanes, date-ordered commits, refs, and colored per-file diffs.",
  "license": "MIT",
  "homepage": "https://github.com/JiaLe1145/dsh-plugin-git-history",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiaLe1145/dsh-plugin-git-history.git"
  },
  "bugs": {
    "url": "https://github.com/JiaLe1145/dsh-plugin-git-history/issues"
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "git", "commit-history"],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
